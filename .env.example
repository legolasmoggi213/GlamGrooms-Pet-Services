PORT=3000
ADMIN_SECRET=replace-with-a-long-random-secret
CUSTOMER_SECRET=replace-with-a-different-long-random-secret
ADMIN_PASS=replace-with-a-strong-admin-password

# CORS — set to your frontend origin in production, e.g. http://localhost:5173
# Leave blank to allow all origins (development default)
CORS_ORIGIN=

# Firebase Admin SDK for Firestore persistence and Firebase ID-token verification
# Set either GOOGLE_APPLICATION_CREDENTIALS to a local service-account JSON path,
# or provide all FIREBASE_* values below.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Booking confirmation email (optional; use a Gmail App Password, not your normal password)
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Twilio SMS delivery for automated service reminders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Service reminder event times are interpreted in this timezone.
REMINDER_TIME_ZONE=Asia/Manila

# PayMongo GCash checkout (use test keys for development)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
